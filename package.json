{
  "name": "gtd-flow",
  "version": "0.14.1",
  "private": true,
  "description": "GTD workflow plugin for Obsidian: inbox, kanban, calendar, tickler, recurring tasks, and project graphs over plain Markdown tasks.",
  "main": "main.js",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "fast-uri": "3.1.4"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run check:core && npm run check:types && node esbuild.config.mjs production && npm run build:mcp && npm run build:widget-core",
    "build:mcp": "node esbuild.mcp.mjs",
    "build:widget-core": "node esbuild.widget.mjs",
    "test": "npm run check:core && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run check:core && vitest run --coverage",
    "test:browser": "playwright test --config playwright.config.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "check:core": "node scripts/check-core-purity.mjs",
    "check:types": "tsc",
    "check:svelte": "node scripts/check-svelte.mjs",
    "check:svelte:semantic": "svelte-check --tsconfig ./tsconfig.svelte.json",
    "check:packaged-plugin": "node scripts/check-packaged-plugin.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "prepare:release": "node scripts/prepare-release.mjs",
    "verify": "npm run lint && npm run format:check && npm run check:svelte && npm run check:svelte:semantic && npm run test:coverage && npm run test:browser && npm run build && npm run check:packaged-plugin && npm run check:bundle-size && npm run verify:release -- --artifacts",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "gtd",
    "tasks",
    "kanban",
    "calendar"
  ],
  "author": "Anton Roudenko",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.62.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.10",
    "builtin-modules": "3.3.0",
    "esbuild": "0.28.1",
    "esbuild-svelte": "^0.9.0",
    "eslint": "10.8.0",
    "eslint-plugin-svelte": "3.22.0",
    "fast-check": "^3.23.0",
    "obsidian": "1.7.2",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.16.0",
    "svelte-check": "4.7.4",
    "svelte-preprocess": "^6.0.3",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@xyflow/svelte": "^1.6.0",
    "ical.js": "^2.2.1"
  }
}
